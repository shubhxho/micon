{
  "name": "neuroviz",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "build:wasm": "npx asc assembly/index.ts -o src/public/wasm/volume.wasm --optimize --exportRuntime",
    "build:client": "bun run build-client.ts",
    "dev": "bun run build:client && bun run --hot src/server.ts",
    "build": "bun run build:client && bun build src/server.ts --outdir dist"
  },
  "dependencies": {
    "hono": "^4.6",
    "dwv": "^0.36",
    "three": "^0.168",
    "@tweenjs/tween.js": "^23"
  },
  "devDependencies": {
    "bun-types": "^1.3.12",
    "assemblyscript": "^0.27"
  }
}
